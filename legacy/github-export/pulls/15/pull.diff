+read_env_file_value() {
+  local var_name="$1"
+  local env_file="$2"
+
+  [[ -f "$env_file" ]] || return 0
+  awk -F= -v key="$var_name" '
+    $1 == key {
+      value = substr($0, length(key) + 2)
+      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
+      gsub(/^["'\''"]|["'\''"]$/, "", value)
+      print value
+      exit
+    }
+  ' "$env_file" 2>/dev/null
+}
