+  .default([])
+  .refine((arr) => new Set(arr.map((s) => s.id)).size === arr.length, {
+    message: "Duplicate schedule ids in schedules[]",
+  });
+
+export type NodeSchedules = z.infer<typeof nodeSchedulesSchema>;
