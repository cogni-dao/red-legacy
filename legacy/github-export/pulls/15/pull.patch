+function isDoltHubRemoteUrl(value: string): boolean {
+  try {
+    const url = new URL(value);
+    return (
+      url.protocol === "https:" &&
+      url.hostname === "doltremoteapi.dolthub.com" &&
+      url.username === "" &&
+      url.password === "" &&
+      url.search === "" &&
+      url.hash === "" &&
+      /^\/[^/]+\/[^/]+$/.test(url.pathname)
+    );
+  } catch {
+    return false;
+  }
+}
