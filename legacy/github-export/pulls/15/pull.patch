+			throw new Error(
+				`[OperatorWallet] ADDRESS_VERIFIED_AT_STARTUP failed: Privy has no wallet matching ` +
+					`repo-spec address ${this.expectedAddress}. Run scripts/provision-operator-wallet.ts first.`,
+			);
