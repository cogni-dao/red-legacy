From 8d8d217eb6021a6ae1673c254a551931ef01380d Mon Sep 17 00:00:00 2001
From: flock-leader <derekgranito+flockleader@gmail.com>
Date: Fri, 26 Jun 2026 11:44:43 -0700
Subject: [PATCH] fix(theme): restore red brand tokens

---
 app/src/styles/tailwind.css | 32 ++++++++++++++++----------------
 1 file changed, 16 insertions(+), 16 deletions(-)

diff --git a/app/src/styles/tailwind.css b/app/src/styles/tailwind.css
index 96200aac..88f34f66 100644
--- a/app/src/styles/tailwind.css
+++ b/app/src/styles/tailwind.css
@@ -127,7 +127,7 @@
     --card-foreground: 222.2 84% 4.9%;
     --popover: 210 40% 96.1%;
     --popover-foreground: 215.4 16.3% 20%;
-    --primary: 222.2 47.4% 11.2%;
+    --primary: 0 74% 48%;
     --primary-foreground: 210 40% 98%;
     --secondary: 210 40% 96.1%;
     --secondary-foreground: 222.2 47.4% 11.2%;
@@ -139,7 +139,7 @@
     --destructive-foreground: var(--color-red-800);
     --border: 214.3 31.8% 91.4%;
     --input: 214.3 31.8% 91.4%;
-    --ring: 222.2 84% 4.9%;
+    --ring: 0 74% 48%;
     --chart-1: 220 70% 50%;
     --chart-2: 160 60% 45%;
     --chart-3: 30 80% 55%;
@@ -154,10 +154,10 @@
     --syntax-string: 27 87% 67%; /* orange/peach - strings & variables */
     --syntax-keyword: 10 50% 50%; /* red/brown - keywords */
 
-    /* Accent gradient stops (aligned with brand hue 217) */
-    --accent-from: 217 85% 50%;
-    --accent-to: 217 100% 70%;
-    --accent-glow: 217 95% 60%;
+    /* Accent gradient stops (aligned with red brand hue) */
+    --accent-from: 0 85% 52%;
+    --accent-to: 0 90% 65%;
+    --accent-glow: 0 90% 58%;
 
     /* Status colors */
     --color-danger: 0 84.2% 60.2%;
@@ -167,12 +167,12 @@
     /* Sidebar */
     --sidebar: 0 0% 98%;
     --sidebar-foreground: 222.2 84% 4.9%;
-    --sidebar-primary: 222.2 47.4% 11.2%;
+    --sidebar-primary: 0 74% 48%;
     --sidebar-primary-foreground: 210 40% 98%;
     --sidebar-accent: 210 40% 96.1%;
     --sidebar-accent-foreground: 222.2 47.4% 11.2%;
     --sidebar-border: 214.3 31.8% 91.4%;
-    --sidebar-ring: 222.2 84% 4.9%;
+    --sidebar-ring: 0 74% 48%;
 
     --radius: 0.5rem;
 
@@ -200,7 +200,7 @@
     --card-foreground: 210 40% 98%;
     --popover: 217.2 32.6% 9%;
     --popover-foreground: 215 20.2% 76.1%;
-    --primary: 217 71% 40%;
+    --primary: 0 74% 48%;
     --primary-foreground: 0 0% 100%;
     --secondary: 217.2 32.6% 17.5%;
     --secondary-foreground: 210 40% 98%;
@@ -212,7 +212,7 @@
     --destructive-foreground: var(--color-red-600);
     --border: 217.2 32.6% 17.5%;
     --input: 217.2 32.6% 17.5%;
-    --ring: 217 71% 40%;
+    --ring: 0 74% 48%;
     --chart-1: 220 70% 50%;
     --chart-2: 160 60% 45%;
     --chart-3: 30 80% 55%;
@@ -227,20 +227,20 @@
     --syntax-string: 20 90% 80%; /* peach/orange - strings & variables */
     --syntax-keyword: 220 100% 65%; /* blue - keywords */
 
-    /* Accent gradient stops (aligned with brand hue 217, darker for dark mode) */
-    --accent-from: 217 80% 45%;
-    --accent-to: 217 100% 60%;
-    --accent-glow: 217 90% 52%;
+    /* Accent gradient stops (aligned with red brand hue, darker for dark mode) */
+    --accent-from: 0 82% 50%;
+    --accent-to: 0 92% 62%;
+    --accent-glow: 0 88% 56%;
 
     /* Sidebar */
     --sidebar: 0 0% 3%;
     --sidebar-foreground: 210 40% 98%;
-    --sidebar-primary: 217 71% 40%;
+    --sidebar-primary: 0 74% 48%;
     --sidebar-primary-foreground: 0 0% 100%;
     --sidebar-accent: 217.2 32.6% 17.5%;
     --sidebar-accent-foreground: 210 40% 98%;
     --sidebar-border: 217.2 32.6% 17.5%;
-    --sidebar-ring: 217 71% 40%;
+    --sidebar-ring: 0 74% 48%;
     --success: var(--color-emerald-500);
     --success-foreground: var(--color-emerald-600);
     --info: var(--color-violet-500);
